# Copy this file to .env and fill in your real values:
#     cp .env.example .env
#
# .env is gitignored — it never gets committed or pushed. Keep it that way.
# Every script here (app.py, scraper.py, outreach.py) loads it automatically,
# so you never need to `export` anything again.

# ---------------------------------------------------------------------------
# Required to scrape
# ---------------------------------------------------------------------------

# Apify Console -> Settings -> Integrations -> Personal API token
APIFY_TOKEN=

# ---------------------------------------------------------------------------
# Required for the web UI (app.py)
# ---------------------------------------------------------------------------

# Password to log into the dashboard. Anyone who reaches the page can spend
# your Apify credit, so make this a real password.
APP_PASSWORD=

# Keeps you logged in across restarts. Generate your own with:
#     python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Required for lead enrichment (enrich.py)
# ---------------------------------------------------------------------------

# Google AI Studio -> Get API key.  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the model. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Only needed once you turn on calling / emailing (outreach.py)
# ---------------------------------------------------------------------------

# Retell dashboard -> API Keys
RETELL_API_KEY=

# Only if you set enable_email: true in outreach_config.json.
# EMAIL_APP_PASSWORD is a Gmail App Password, NOT your normal password:
# https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
